        </mxCell>
        <mxCell id="lg3a" edge="1" parent="1" style="endArrow=block;html=1;strokeWidth=2;dashed=1;strokeColor=#d6b656;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
